{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:contracts": "vitest run --config vitest.contracts.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:mutation": "stryker run",
    "test:ci": "npm run test:unit:coverage && npm run test:e2e",
    "test:security:email": "node --test tests/security/email-hook.test.cjs",
    "test:security:db": "python3 tests/security/run-database.py"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.564.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "29.1.1",
    "standardwebhooks": "1.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "picomatch": "4.0.4",
    "postcss": "8.5.25",
    "qs": "6.17.1",
    "sharp": "0.35.5",
    "nanoid": "3.3.18",
    "js-yaml": "4.3.2",
    "fast-uri": "3.1.9"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@swc/core@1.16.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "msw": false,
    "sharp@0.35.3": true,
    "unrs-resolver@1.11.1": true
  }
}
