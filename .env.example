# Supabase - get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — required for admin operations (account deletion)
# Get from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL used for OAuth redirect generation
# Local: http://localhost:3001
# Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Enable silent anonymous auth sessions for guest claim ownership + private realtime
NEXT_PUBLIC_ENABLE_ANONYMOUS_AUTH=true

# Enable mobile install prompt surfaces (home + post-claim)
NEXT_PUBLIC_ENABLE_INSTALL_PROMPT=false

# Server-only secret used to sign temporary anonymous merge state cookies
# Generate with: openssl rand -base64 32
AUTH_MERGE_COOKIE_SECRET=replace-with-long-random-secret
